# ───────────────────────────────────────────────────────────────────────────
#  DFW Uber Earnings Maximizer — environment configuration
#  Copy to ".env" and fill in. Leave Uber values blank to run in DEMO mode
#  (realistic seeded data so every panel works before Driver API approval).
# ───────────────────────────────────────────────────────────────────────────

# Server
PORT=4000
SESSION_SECRET=change-me-to-a-long-random-string

# ── Uber Driver API (OAuth 2.0 Authorization Code flow) ──────────────────────
# Create an app at https://developer.uber.com/dashboard and apply for limited
# Driver API access. These power /partners/me, /partners/payments, /partners/trips.
UBER_CLIENT_ID=
UBER_CLIENT_SECRET=
# Must EXACTLY match a Redirect URI registered on your Uber app.
UBER_REDIRECT_URI=http://localhost:4000/auth/uber/callback

# ── Uber Rides API (rider-side) server token ─────────────────────────────────
# Found under "Server Token" on your Uber app's Auth page. Used ONLY for the
# surge detector (GET /v1.2/products and /v1.2/estimates/price). Optional —
# without it the surge panel runs on a time-of-day demand model.
UBER_SERVER_TOKEN=

# ── Surge detector ───────────────────────────────────────────────────────────
# Cron expression for zone polling. Default: every 10 minutes.
SURGE_CRON=*/10 * * * *

# Force demo mode even if Uber credentials are present (optional).
# DEMO_MODE=true
