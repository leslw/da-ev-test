{
  "name": "dfw-uber-earnings-maximizer",
  "version": "1.0.0",
  "description": "Local web app to help a DFW-area Uber driver maximize earnings: Driver API integration, earnings analysis, metro surge detection, car-category optimizer, and a weekly shift planner.",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "seed": "node server/seed.js",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "client:install": "npm --prefix client install",
    "build": "npm run client:install && npm run client:build",
    "test": "node --test"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "better-sqlite3": "^11.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-session": "^1.18.0",
    "node-cron": "^3.0.3",
    "passport": "^0.7.0",
    "passport-oauth2": "^1.8.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.7"
  }
}
